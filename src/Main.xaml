<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BanaStudio" Width="680" Height="790" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="#01FFFFFF" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Foreground="#26272B">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#A8F0F0F2"/><Setter Property="Foreground" Value="#36373B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,10"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="#70FFFFFF" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="#D8A926"/><Setter TargetName="Bg" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Switch" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Track" Width="42" Height="25" Background="#9ADADADD" CornerRadius="13"><Border x:Name="Thumb" Width="19" Height="19" Margin="3" Background="#EFFFFFFF" CornerRadius="10" HorizontalAlignment="Left"><Border.Effect><DropShadowEffect Color="#444444" Opacity="0.14" BlurRadius="3" ShadowDepth="1"/></Border.Effect></Border></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#E4B637"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#91701B"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Segment" TargetType="RadioButton"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#77787E"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Tile" CornerRadius="10" Background="Transparent" Margin="3" Padding="14,9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="#DFFFFFFF"/><Setter Property="Foreground" Value="#27282C"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#D8A926"/><Setter TargetName="Tile" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#3E3F44"/><Setter Property="FontSize" Value="13"/><Setter Property="Height" Value="38"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#AFFFFFFF" BorderBrush="#90FFFFFF" BorderThickness="1" CornerRadius="9"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,3" Foreground="#8D8E93"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center" Margin="12,0,32,0"/><Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#F2FFFFFF" CornerRadius="9" BorderBrush="#E2E2E6" BorderThickness="1" Padding="6" MinWidth="220"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,8"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#BFFFFFFF"/><Setter Property="CornerRadius" Value="16"/><Setter Property="BorderBrush" Value="#AFFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18"/></Style>
 </Window.Resources>
 <Border CornerRadius="22" Background="#C5F8F8FA" BorderBrush="#B8FFFFFF" BorderThickness="1">
  <Grid><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
   <Grid x:Name="Header" Margin="26,0,18,0" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="BrandIcon" Width="42" Height="42" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="BanaStudio" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="录屏 · 截图 · 语音识别" FontSize="11" Foreground="#777980" Margin="1,1,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="SettingsButton" Content="设置" Background="Transparent" Foreground="#777980" Padding="12,9"/><Button x:Name="MinButton" Content="—" Background="Transparent" Foreground="#777980" Width="34" Padding="0"/><Button x:Name="CloseButton" Content="×" Background="Transparent" Foreground="#777980" FontSize="22" Width="34" Padding="0"/></StackPanel></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="30,0,30,18">
    <Border x:Name="ModeTabs" CornerRadius="13" Background="#80E4E4E8" BorderBrush="#70FFFFFF" BorderThickness="1" Margin="0,0,0,18"><UniformGrid Columns="3"><RadioButton x:Name="RecordTab" GroupName="Mode" Style="{StaticResource Segment}" IsChecked="True" Content="录制视频"/><RadioButton x:Name="ScreenshotTab" GroupName="Mode" Style="{StaticResource Segment}" Content="截取画面"/><RadioButton x:Name="VoiceTab" GroupName="Mode" Style="{StaticResource Segment}" Content="语音识别"/></UniformGrid></Border>
    <StackPanel x:Name="RecordPane"><Grid Margin="0,0,0,15"><TextBlock Text="屏幕录制" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="QualityLabel" Text="原生画质 · 30 FPS" FontSize="11" Foreground="#777980" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,3"/></Grid>
     <Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="录制区域" VerticalAlignment="Center" FontWeight="SemiBold"/><ComboBox x:Name="Screens" Grid.Column="1"/></Grid><Border Height="88" Margin="0,18,0,16" CornerRadius="11" Background="#70FFFFFF" BorderBrush="#60FFFFFF" BorderThickness="1"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal"><Grid Width="58" Height="48" Margin="0,0,18,0"><Border BorderBrush="#9A9BA0" BorderThickness="1.5" CornerRadius="5" Height="35" VerticalAlignment="Top"/><Border Width="18" Height="2" Background="#9A9BA0" VerticalAlignment="Bottom" Margin="0,0,0,5"/><Border Width="2" Height="8" Background="#9A9BA0" VerticalAlignment="Bottom" Margin="0,0,0,7"/><Border Width="26" Height="17" Background="#BFFAE9A8" CornerRadius="3" VerticalAlignment="Top" Margin="0,9,0,0"/></Grid><StackPanel VerticalAlignment="Center"><TextBlock x:Name="RegionSize" Text="2560 × 1440" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="RegionHint" Text="整个屏幕 · 原始像素" Foreground="#777980" FontSize="12" Margin="0,4,0,0"/></StackPanel></StackPanel></Grid></Border><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="FullButton" Content="整个屏幕"/><Button x:Name="RegionButton" Grid.Column="2" Content="框选区域" Background="#BFF8EFCF" Foreground="#745A18"/></Grid></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="22,14"><StackPanel><Grid Height="38"><StackPanel VerticalAlignment="Center"><TextBlock Text="系统声音" FontWeight="SemiBold"/><TextBlock Text="视频、音乐和应用声音" FontSize="11" Foreground="#777980" Margin="0,3,0,0"/></StackPanel><CheckBox x:Name="SystemAudio" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" AutomationProperties.Name="系统声音"/></Grid><Border Height="1" Background="#70FFFFFF" Margin="0,10"/><Grid Height="38"><StackPanel VerticalAlignment="Center"><TextBlock Text="麦克风" FontWeight="SemiBold"/><TextBlock Text="录制默认输入设备" FontSize="11" Foreground="#777980" Margin="0,3,0,0"/></StackPanel><CheckBox x:Name="Microphone" Style="{StaticResource Switch}" HorizontalAlignment="Right" AutomationProperties.Name="麦克风"/></Grid></StackPanel></Border>
     <Button x:Name="StartButton" Height="49" Margin="0,18,0,0" Background="#E9BE46" Foreground="#453819" FontSize="15" FontWeight="SemiBold" Content="开始录制"/><TextBlock x:Name="RecordHotkeyHint" Text="3 秒倒计时   ·   Ctrl + Shift + F9 开始 / 停止" HorizontalAlignment="Center" FontSize="11" Foreground="#777980" Margin="0,11,0,0"/>
    </StackPanel>
    <StackPanel x:Name="ShotPane" Visibility="Collapsed"><TextBlock Text="屏幕截图" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/><Border Style="{StaticResource Card}" Padding="26,24"><StackPanel><Grid Width="110" Height="88" Margin="0,12,0,24"><Border BorderBrush="#DBB953" BorderThickness="2" CornerRadius="12" Background="#BFFFF9E8"/><Ellipse Width="17" Height="17" Fill="#EDCD71" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,18,0"/><Path Data="M 18,65 L 40,40 L 58,57 L 70,47 L 93,70 Z" Fill="#E9CC7B"/></Grid><TextBlock Text="选择截图区域" HorizontalAlignment="Center" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="框选后可标注，完成后保存。" HorizontalAlignment="Center" Foreground="#777980" Margin="0,10,0,22" FontSize="12"/><Border Background="#9FFFFFFF" BorderBrush="#90FFFFFF" BorderThickness="1" CornerRadius="10" Padding="18,11" HorizontalAlignment="Center"><TextBlock x:Name="ScreenshotHotkeyHero" Text="Ctrl  +  Alt  +  A" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="15"/></Border><Border Height="1" Background="#70FFFFFF" Margin="0,28,0,22"/><TextBlock Text="画笔 · 荧光笔 · 橡皮擦" HorizontalAlignment="Center" FontSize="13"/><TextBlock Text="自动保存到下载文件夹，同时复制到剪贴板" Foreground="#777980" HorizontalAlignment="Center" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border><Button x:Name="ScreenshotButton" Content="截取画面" Height="49" Margin="0,18,0,0" Background="#E9BE46" Foreground="#453819" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Esc 或右键取消   ·   支持多个显示器" HorizontalAlignment="Center" FontSize="11" Foreground="#777980" Margin="0,11,0,0"/></StackPanel>
    <StackPanel x:Name="SettingsPane" Visibility="Collapsed"><TextBlock Text="偏好设置" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><Grid Margin="0,0,0,20"><StackPanel><TextBlock Text="登录时自动启动" FontWeight="SemiBold"/><TextBlock Text="安静驻留托盘，不弹出窗口" Foreground="#777980" FontSize="11" Margin="0,6,0,0"/></StackPanel><CheckBox x:Name="AutoStart" Style="{StaticResource Switch}" HorizontalAlignment="Right" AutomationProperties.Name="登录时自动启动"/></Grid><Border Height="1" Background="#70FFFFFF"/><Grid Margin="0,16,0,16"><StackPanel><TextBlock Text="截图快捷键" FontWeight="SemiBold"/><TextBlock Text="随时框选并进入标注" Foreground="#777980" FontSize="11" Margin="0,6,0,0"/></StackPanel><Button x:Name="ScreenshotShortcutButton" Content="Ctrl + Alt + A" HorizontalAlignment="Right" MinWidth="150" Background="#AFFFFFFF" AutomationProperties.Name="修改截图快捷键"/></Grid><Border Height="1" Background="#70FFFFFF"/><Grid Margin="0,16,0,0"><StackPanel><TextBlock Text="录屏快捷键" FontWeight="SemiBold"/><TextBlock Text="开始或停止当前录制" Foreground="#777980" FontSize="11" Margin="0,6,0,0"/></StackPanel><Button x:Name="RecordingShortcutButton" Content="Ctrl + Shift + F9" HorizontalAlignment="Right" MinWidth="150" Background="#AFFFFFFF" AutomationProperties.Name="修改录屏快捷键"/></Grid></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><Grid><TextBlock Text="录制帧率" VerticalAlignment="Center" FontWeight="SemiBold"/><ComboBox x:Name="Framerate" Width="150" HorizontalAlignment="Right"><ComboBoxItem Content="30 帧 / 秒"/><ComboBoxItem Content="60 帧 / 秒"/></ComboBox></Grid><Border Height="1" Background="#70FFFFFF" Margin="0,20"/><Grid><StackPanel><TextBlock Text="兼容模式" FontWeight="SemiBold"/><TextBlock Text="硬件编码失败时，改用 CPU 录制" Foreground="#777980" FontSize="11" Margin="0,6,0,0"/></StackPanel><CheckBox x:Name="Compatibility" Style="{StaticResource Switch}" HorizontalAlignment="Right" AutomationProperties.Name="兼容模式"/></Grid></StackPanel></Border><Border Background="#70FFFFFF" BorderBrush="#70FFFFFF" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,20,0,0"><TextBlock Text="点击快捷键即可重新设置。关闭窗口后，BanaStudio 会继续驻留托盘。" Foreground="#777980" FontSize="12" LineHeight="22" TextWrapping="Wrap"/></Border><Button x:Name="BackButton" Content="返回" Margin="0,20,0,0" Height="42"/></StackPanel>
    <StackPanel x:Name="VoicePane" Visibility="Collapsed">
     <Grid Margin="0,0,0,15"><TextBlock Text="语音识别" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="VoiceServiceStatus" Text="尚未配置" FontSize="11" Foreground="#777980" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
     <Border Style="{StaticResource Card}"><StackPanel>
      <Grid><TextBlock Text="识别方式" FontWeight="SemiBold"/><ComboBox x:Name="VoiceBackend" Width="230" HorizontalAlignment="Right"><ComboBoxItem Content="实时流式（需单独开通）"/><ComboBoxItem Content="极速识别（说完出字）"/></ComboBox></Grid>
      <Border Height="1" Background="#70FFFFFF" Margin="0,14"/><Grid><TextBlock Text="操作方式" FontWeight="SemiBold"/><ComboBox x:Name="VoiceBehavior" Width="230" HorizontalAlignment="Right"><ComboBoxItem Content="按一下开始，再按一下结束"/><ComboBoxItem Content="按住讲话，松开结束"/></ComboBox></Grid>
      <Border Height="1" Background="#70FFFFFF" Margin="0,14"/><Grid><StackPanel><TextBlock Text="语音快捷键" FontWeight="SemiBold"/><TextBlock Text="默认 Ctrl + Alt + Space" FontSize="11" Foreground="#777980"/></StackPanel><Button x:Name="VoiceShortcutButton" Content="Ctrl + Alt + Space" HorizontalAlignment="Right" MinWidth="180"/></Grid>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><ProgressBar x:Name="VoiceLevel" Height="6" Minimum="0" Maximum="1"/><TextBlock x:Name="VoiceTranscript" Text="按快捷键开始讲话" TextWrapping="Wrap" MinHeight="52" Margin="0,10,0,0"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="VoiceStartButton" Content="开始试录" Background="#E9BE46"/><Button x:Name="VoiceCancelButton" Grid.Column="2" Content="取消"/></Grid></StackPanel></Border>
     <Expander Header="豆包语音服务设置" Margin="0,14,0,0"><Border Style="{StaticResource Card}" Margin="0,8,0,0"><StackPanel><Button x:Name="ImportAsrConfigButton" Content="读取本机已有配置" HorizontalAlignment="Right"/><TextBlock Text="新版 API Key" FontSize="11" Foreground="#777980" Margin="0,8,0,3"/><PasswordBox x:Name="VoiceApiKey" Height="32"/><TextBlock Text="旧版 App ID" FontSize="11" Foreground="#777980" Margin="0,7,0,3"/><TextBox x:Name="VoiceAppKey" Height="32"/><TextBlock Text="旧版 Access Token" FontSize="11" Foreground="#777980" Margin="0,7,0,3"/><PasswordBox x:Name="VoiceAccessKey" Height="32"/><TextBlock Text="Resource ID" FontSize="11" Foreground="#777980" Margin="0,7,0,3"/><TextBox x:Name="VoiceResourceId" Height="32"/><Button x:Name="SaveVoiceSettingsButton" Content="保存服务设置" Margin="0,9,0,0"/><TextBlock Text="凭据由 Windows 当前用户加密保护；音频和启用热词会发送至豆包。" TextWrapping="Wrap" FontSize="11" Foreground="#777980" Margin="0,7,0,0"/></StackPanel></Border></Expander>
     <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><Grid><TextBlock Text="专有词库" FontWeight="SemiBold"/><TextBlock x:Name="VoiceTermCount" Text="0 个启用 · 前约 100 tokens 生效" HorizontalAlignment="Right" FontSize="11" Foreground="#777980"/></Grid><TextBox x:Name="VoiceTermInput" Margin="0,9,0,0" Height="32" ToolTip="输入正确词语"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="VoiceAddTermButton" Content="添加"/><Button x:Name="VoiceImportTermsButton" Grid.Column="2" Content="导入"/><Button x:Name="VoiceExportTermsButton" Grid.Column="4" Content="导出"/></Grid><Button x:Name="VoiceLibraryButton" Content="管理词库、历史与纠错" Margin="0,8,0,0"/></StackPanel></Border>
    </StackPanel>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" BorderBrush="#70FFFFFF" BorderThickness="0,1,0,0" Margin="28,0"><Grid><TextBlock x:Name="Status" Text="准备就绪" VerticalAlignment="Center" FontSize="11" Foreground="#777980" TextTrimming="CharacterEllipsis" Margin="0,0,146,0"/><Button x:Name="FolderButton" Content="打开下载文件夹  ↗" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Foreground="#666870" Padding="0" FontSize="11"/></Grid></Border>
  </Grid>
 </Border>
</Window>
